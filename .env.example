# ---- Telegram ----
# @BotFather → /newbot → token
BOT_TOKEN=
# Your Telegram numeric id(s) (get it from @userinfobot), comma separated
ADMIN_IDS=
# Public HTTPS address of this server, e.g. https://34-123-45-67.sslip.io
PUBLIC_URL=

# ---- Security ----
# Random long string; generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# Never change it after launch (stored Moodle links are encrypted with it)
SECRET_KEY=

# ---- Moodle ----
MOODLE_BASE=https://moodle.uwed.uz
SYNC_INTERVAL_MIN=30

# ---- AI ----
# gemini (default: free tier, understands text + photos + PDF + voice) or bedrock (Claude, paid)
AI_PROVIDER=gemini
# https://aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
AI_MAX_VOICE_SEC=300

# ---- Optional: Amazon Bedrock (only if AI_PROVIDER=bedrock) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-5-20251101-v1:0
AI_MAX_TOKENS=1500

# ---- Storage (default SQLite in ./data) ----
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db
TIMEZONE=Asia/Tashkent

# ---- Deploy (docker-compose) ----
# Domain for HTTPS; with no domain use <ip-with-dashes>.sslip.io
DOMAIN=
